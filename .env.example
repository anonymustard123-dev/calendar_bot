# Vercel Project Settings -> Environment Variables (server-side only).
CALENDAR_ACCESS_PASSWORD=replace-with-a-strong-shared-password
# Project URL OR Data API URL, e.g. https://YOUR_PROJECT_REF.supabase.co/rest/v1/
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co/rest/v1/
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
